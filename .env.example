# Spotter Trip Planner — environment template
# Copy this to .env and fill in the values. The real .env is gitignored.

# OpenRouteService API key — get free at https://openrouteservice.org/dev/#/signup
# Used for truck-aware routing (driving-hgv profile) and geocoding
ORS_API_KEY=

# Django
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Frontend — points the React app at the Django backend
VITE_API_BASE_URL=http://localhost:8000
